<Application x:Class="AppEscritorioGestor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="AzulPincel" Color="#1C3A70"/>
        <SolidColorBrush x:Key="DoradoPincel" Color="#E9BC3C"/>
        <SolidColorBrush x:Key="AmarilloActivoPincel" Color="#FFC107"/>
        <SolidColorBrush x:Key="FondoClaroPincel" Color="#F8F9FA"/>
        <SolidColorBrush x:Key="TextoSecundarioPincel" Color="#757575"/>
        <SolidColorBrush x:Key="BordeEntradaPincel" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="ErrorPincel" Color="#F44336"/>

        <DropShadowEffect x:Key="SombraTarjeta" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.10" Color="Black"/>

        <LinearGradientBrush x:Key="InsigniaFondoPincel" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4A74C4" Offset="0"/>
            <GradientStop Color="#2A4F94" Offset="0.45"/>
            <GradientStop Color="#142B57" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InsigniaBrilloPincel" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#55FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.55"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="SombraInsignia" BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#1C3A70"/>
        <DropShadowEffect x:Key="SombraGlifo" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.55" Color="Black"/>

        <Style x:Key="InsigniaIconoEstilo" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InsigniaFondoPincel}"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource SombraInsignia}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CabeceraEstilo" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AzulPincel}"/>
            <Setter Property="CornerRadius" Value="0,0,30,30"/>
        </Style>

        <Style x:Key="TarjetaEstilo" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource SombraTarjeta}"/>
        </Style>

        <Style x:Key="EtiquetaEstilo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundarioPincel}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="BotonPrimarioEstilo" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AzulPincel}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#9AA5B8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonSecundarioEstilo" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AzulPincel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AzulPincel}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#1A1C3A70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonDoradoEstilo" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DoradoPincel}"/>
            <Setter Property="Foreground" Value="{StaticResource AzulPincel}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}" Effect="{StaticResource SombraTarjeta}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonTarjetaEstilo" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="16" Effect="{StaticResource SombraTarjeta}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#EEF2F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonIconoEstilo" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#1F808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonAvatarEstilo" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AzulPincel}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="{StaticResource AmarilloActivoPincel}" CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="PastillaActivaPincel" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FFE27A" Offset="0"/>
            <GradientStop Color="#F2BE2E" Offset="0.55"/>
            <GradientStop Color="#D9A21B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BarraFondoPincel" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#2A4F94" Offset="0"/>
            <GradientStop Color="#1C3A70" Offset="0.12"/>
            <GradientStop Color="#15305F" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="BrilloDorado" BlurRadius="16" ShadowDepth="0" Opacity="0.75" Color="#E9BC3C"/>

        <Style x:Key="GlifoNavegacionEstilo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Activo">
                    <Setter Property="Foreground" Value="{StaticResource AzulPincel}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonNavegacionEstilo" TargetType="Button">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Raiz" Background="Transparent" Margin="0,8,0,6" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Pastilla" Width="58" Height="34" VerticalAlignment="Top" CornerRadius="17" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pastilla" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Activo">
                                <Setter TargetName="Pastilla" Property="Background" Value="{StaticResource PastillaActivaPincel}"/>
                                <Setter TargetName="Pastilla" Property="BorderBrush" Value="#FFF6CF"/>
                                <Setter TargetName="Pastilla" Property="Effect" Value="{StaticResource BrilloDorado}"/>
                                <Setter TargetName="Raiz" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-3"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="Tag" Value="Activo">
                    <Setter Property="Foreground" Value="{StaticResource AmarilloActivoPincel}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EntradaTextBoxEstilo" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeEntradaPincel}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource AzulPincel}"/>
                                <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#F1F3F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EntradaPasswordBoxEstilo" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BordeEntradaPincel}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource AzulPincel}"/>
                                <Setter TargetName="Borde" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonDiaEstilo" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Raiz" Background="Transparent">
                            <ContentPresenter/>
                            <Ellipse x:Name="Hover" Fill="#22FFFFFF" Visibility="Collapsed" Margin="3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonCabeceraEstilo" TargetType="Button" BasedOn="{StaticResource BotonIconoEstilo}">
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Application.Resources>
</Application>
