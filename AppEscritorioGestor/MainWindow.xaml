<Window x:Class="AppEscritorioGestor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IES Marcos Zaragoza · Gestión de permisos"
        Width="1000" Height="780" MinWidth="820" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FondoClaroPincel}"
        Closing="MainWindow_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ContentControl x:Name="ContenidoPrincipalContentControl" Grid.Row="0" IsTabStop="False"/>

        <local:BarraNavegacion x:Name="BarraNavegacionPrincipal" Grid.Row="1" Visibility="Collapsed" xmlns:local="clr-namespace:AppEscritorioGestor"/>
    </Grid>
</Window>
