<UserControl x:Class="AppEscritorioGestor.SolicitudesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CabeceraEstilo}" Height="110">
            <Grid MaxWidth="760" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="VolverInicioBoton" Grid.Column="0" Style="{StaticResource BotonIconoEstilo}" Foreground="White" Content="&#xE72B;" ToolTip="Volver al inicio" Click="VolverInicioBoton_Click"/>
                <TextBlock Grid.Column="1" Text="Mis asuntos propios" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MaxWidth="760">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,24,24,100">
                    <Border x:Name="MensajeBorder" Background="#E8F5E9" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="MensajeTextBlock" Foreground="#2E7D32" FontSize="14"/>
                    </Border>
                    <ItemsControl x:Name="SolicitudesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12" Effect="{StaticResource SombraTarjeta}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiaTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AzulPincel}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding MesTexto}" FontSize="12" Foreground="{StaticResource TextoSecundarioPincel}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FechaLargaTexto}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding TipoTexto}" FontSize="12" Foreground="{StaticResource TextoSecundarioPincel}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{Binding EstadoFondoPincel}" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoPincel}" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                        <Button x:Name="AnularSolicitudBoton" Grid.Column="3" Style="{StaticResource BotonIconoEstilo}" Foreground="{StaticResource ErrorPincel}" Content="&#xE711;" Margin="8,0,0,0" ToolTip="Anular" Visibility="{Binding PuedeAnularVisibilidad}" Click="AnularSolicitudBoton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>


            <StackPanel x:Name="EstadoPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EstadoTextBlock" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextoSecundarioPincel}"/>
                <Button x:Name="ReintentarBoton" Style="{StaticResource BotonPrimarioEstilo}" Content="Reintentar" Width="160" Margin="0,14,0,0" Visibility="Collapsed" Click="ReintentarBoton_Click"/>
            </StackPanel>

            <Button x:Name="PedirDiaBoton" Style="{StaticResource BotonDoradoEstilo}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Click="PedirDiaBoton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Pedir día" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
