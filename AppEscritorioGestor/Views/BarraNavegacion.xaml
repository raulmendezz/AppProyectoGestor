<UserControl x:Class="AppEscritorioGestor.BarraNavegacion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource BarraFondoPincel}" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
        <UniformGrid Rows="1" MaxWidth="800">
            <Button x:Name="InicioNavegacionBoton" Style="{StaticResource BotonNavegacionEstilo}" Click="NavegacionBoton_Click">
                <StackPanel>
                    <Grid Width="58" Height="34">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource GlifoNavegacionEstilo}"/>
                    </Grid>
                    <TextBlock Text="Inicio" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="CalendarioNavegacionBoton" Style="{StaticResource BotonNavegacionEstilo}" Click="NavegacionBoton_Click">
                <StackPanel>
                    <Grid Width="58" Height="34">
                        <TextBlock Text="&#xE787;" Style="{StaticResource GlifoNavegacionEstilo}"/>
                    </Grid>
                    <TextBlock Text="Calendario" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="PermisosNavegacionBoton" Style="{StaticResource BotonNavegacionEstilo}" Click="NavegacionBoton_Click">
                <StackPanel>
                    <Grid Width="58" Height="34">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource GlifoNavegacionEstilo}"/>
                    </Grid>
                    <TextBlock Text="Permisos" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="PerfilNavegacionBoton" Style="{StaticResource BotonNavegacionEstilo}" Click="NavegacionBoton_Click">
                <StackPanel>
                    <Grid Width="58" Height="34">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource GlifoNavegacionEstilo}"/>
                    </Grid>
                    <TextBlock Text="Perfil" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Border>
</UserControl>
