<UserControl x:Class="AppEscritorioGestor.CalendarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CabeceraEstilo}" Padding="0,10,0,6">
            <StackPanel MaxWidth="620" Margin="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="VolverInicioBoton" Grid.Column="0" Style="{StaticResource BotonCabeceraEstilo}" Content="&#xE72B;" ToolTip="Volver al inicio" Click="VolverInicioBoton_Click"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="MesAnteriorBoton" Style="{StaticResource BotonCabeceraEstilo}" Content="&#xE76B;" ToolTip="Anterior" Click="MesAnteriorBoton_Click"/>
                        <Button x:Name="MesBoton" Style="{StaticResource BotonCabeceraEstilo}" Width="Auto" MinWidth="190" Padding="12,0" ToolTip="Plegar o desplegar" Click="PlegarBoton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="MesTextBlock" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="PlegarGlifoTextBlock" Text="&#xE70E;" FontSize="14" Margin="8,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MesSiguienteBoton" Style="{StaticResource BotonCabeceraEstilo}" Content="&#xE76C;" ToolTip="Siguiente" Click="MesSiguienteBoton_Click"/>
                    </StackPanel>
                    <Button x:Name="HoyBoton" Grid.Column="2" Style="{StaticResource BotonCabeceraEstilo}" Content="&#xE8BF;" ToolTip="Ir a hoy" Click="HoyBoton_Click"/>
                </Grid>

                <UniformGrid Rows="1" Margin="0,10,0,4">
                    <TextBlock Text="L" Foreground="#B3FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="M" Foreground="#B3FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="X" Foreground="#B3FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="J" Foreground="#B3FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="V" Foreground="#B3FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="S" Foreground="#B3FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="D" Foreground="#B3FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </UniformGrid>

                <UniformGrid x:Name="CuadriculaUniformGrid" Columns="7"/>

                <Button x:Name="PlegarBoton" Style="{StaticResource BotonCabeceraEstilo}" Width="60" Height="24" FontSize="14" Content="&#xE70E;" ToolTip="Plegar o desplegar" Click="PlegarBoton_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" MaxWidth="760">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,18,24,96">
                    <TextBlock x:Name="FechaSeleccionadaTextBlock" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AzulPincel}" Margin="0,0,0,14"/>
                    <Border x:Name="MensajeBorder" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock x:Name="MensajeTextBlock" FontSize="14" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel x:Name="EventosPanel"/>
                </StackPanel>
            </ScrollViewer>

            <Button x:Name="NuevoBloqueoBoton" Style="{StaticResource BotonDoradoEstilo}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Visibility="Collapsed" Click="NuevoBloqueoBoton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Bloqueo" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
