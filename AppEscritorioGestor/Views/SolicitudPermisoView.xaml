<UserControl x:Class="AppEscritorioGestor.SolicitudPermisoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CabeceraEstilo}" Height="110">
            <Grid MaxWidth="760" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="VolverSolicitudesBoton" Grid.Column="0" Style="{StaticResource BotonIconoEstilo}" Foreground="White" Content="&#xE72B;" ToolTip="Volver a mis solicitudes" Click="VolverSolicitudesBoton_Click"/>
                <TextBlock Grid.Column="1" Text="Solicitud de permiso" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource TarjetaEstilo}" MaxWidth="760" Margin="24,16" Padding="28,20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Pedir un día" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="La solicitud quedará pendiente hasta que la apruebe el administrador." Foreground="{StaticResource TextoSecundarioPincel}" Margin="0,4,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Profesor" Style="{StaticResource EtiquetaEstilo}"/>
                            <TextBox x:Name="ProfesorTextBox" Style="{StaticResource EntradaTextBoxEstilo}" IsReadOnly="True" TabIndex="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Departamento" Style="{StaticResource EtiquetaEstilo}"/>
                            <TextBox x:Name="DepartamentoTextBox" Style="{StaticResource EntradaTextBoxEstilo}" IsReadOnly="True" TabIndex="1"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fecha del permiso" Style="{StaticResource EtiquetaEstilo}"/>
                            <DatePicker x:Name="FechaPermisoDatePicker" Height="42" FontSize="14" VerticalContentAlignment="Center" TabIndex="2" SelectedDateChanged="FechaPermisoDatePicker_SelectedDateChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tipo de día" Style="{StaticResource EtiquetaEstilo}"/>
                            <ComboBox x:Name="TipoLectivoComboBox" Height="42" FontSize="14" VerticalContentAlignment="Center" TabIndex="3"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="No se pueden elegir fines de semana, días bloqueados ni días ya solicitados." FontSize="12" Foreground="{StaticResource TextoSecundarioPincel}" Margin="0,6,0,0"/>

                    <Grid Margin="0,16,0,4">
                        <TextBlock Text="Motivo (opcional)" Style="{StaticResource EtiquetaEstilo}"/>
                        <TextBlock x:Name="MotivoContadorTextBlock" Text="0/200" Style="{StaticResource EtiquetaEstilo}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBox x:Name="MotivoTextBox" Style="{StaticResource EntradaTextBoxEstilo}" Height="72" MaxLength="200" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TabIndex="4" TextChanged="MotivoTextBox_TextChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Estado inicial" Style="{StaticResource EtiquetaEstilo}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Border Background="#26FFA000" CornerRadius="12" Padding="12,4">
                            <TextBlock x:Name="EstadoInicialTextBlock" Text="Pendiente" Foreground="#FFA000" FontWeight="Bold" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <CheckBox x:Name="DeclaracionCheckBox" Margin="0,16,0,0" TabIndex="5" Checked="DeclaracionCheckBox_Cambiado" Unchecked="DeclaracionCheckBox_Cambiado">
                        <TextBlock TextWrapping="Wrap" Text="Declaro que los datos son correctos y entiendo que la concesión queda sujeta a la autorización de la dirección."/>
                    </CheckBox>

                    <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource ErrorPincel}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EnviarSolicitudBoton" Grid.Column="0" Style="{StaticResource BotonPrimarioEstilo}" Content="Enviar solicitud" IsEnabled="False" TabIndex="6" Click="EnviarSolicitudBoton_Click"/>
                        <Button x:Name="LimpiarFormularioBoton" Grid.Column="2" Style="{StaticResource BotonSecundarioEstilo}" Content="Limpiar" TabIndex="7" Click="LimpiarFormularioBoton_Click"/>
                        <Button x:Name="VolverInicioBoton" Grid.Column="4" Style="{StaticResource BotonSecundarioEstilo}" Content="Volver al inicio" TabIndex="8" Click="VolverInicioBoton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
