<Window x:Class="AppEscritorioGestor.BloqueoFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FondoClaroPincel}">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TituloTextBlock" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="En estas fechas no se podrán pedir asuntos propios." Foreground="{StaticResource TextoSecundarioPincel}" Margin="0,4,0,18"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Desde" Style="{StaticResource EtiquetaEstilo}"/>
                <DatePicker x:Name="DesdeDatePicker" Height="42" FontSize="14" VerticalContentAlignment="Center" TabIndex="0" SelectedDateChanged="DesdeDatePicker_SelectedDateChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Hasta" Style="{StaticResource EtiquetaEstilo}"/>
                <DatePicker x:Name="HastaDatePicker" Height="42" FontSize="14" VerticalContentAlignment="Center" TabIndex="1"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Tipo" Style="{StaticResource EtiquetaEstilo}" Margin="0,16,0,4"/>
        <ComboBox x:Name="TipoComboBox" Height="42" FontSize="14" VerticalContentAlignment="Center" TabIndex="2" SelectionChanged="TipoComboBox_SelectionChanged"/>

        <StackPanel x:Name="OtroPanel" Visibility="Collapsed">
            <TextBlock Text="Escribe el tipo" Style="{StaticResource EtiquetaEstilo}" Margin="0,16,0,4"/>
            <TextBox x:Name="OtroTextBox" Style="{StaticResource EntradaTextBoxEstilo}" MaxLength="60" TabIndex="3"/>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock" Foreground="{StaticResource ErrorPincel}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelarBoton" Grid.Column="0" Style="{StaticResource BotonSecundarioEstilo}" Content="Cancelar" IsCancel="True" TabIndex="5"/>
            <Button x:Name="GuardarBoton" Grid.Column="2" Style="{StaticResource BotonPrimarioEstilo}" Content="Guardar" IsDefault="True" TabIndex="4" Click="GuardarBoton_Click"/>
        </Grid>
    </StackPanel>
</Window>
